<Project Sdk="Microsoft.NET.Sdk">
	<!-- A test mod, never released: it misbehaves on purpose so UserFeedback's defences can be seen working -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<RootNamespace>UserFeedbackPatchTest</RootNamespace>
		<!-- No UserFeedback.dll reference: it finds UserFeedback's code by name, like a real foreign mod would -->
	</PropertyGroup>

	<PropertyGroup Condition="'$(VINTAGE_STORY)' == ''">
		<VINTAGE_STORY>/var/lib/flatpak/app/at.vintagestory.VintageStory/current/active/files/extra/vintagestory</VINTAGE_STORY>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="VintagestoryAPI">
			<HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="0Harmony">
			<HintPath>$(VINTAGE_STORY)/Lib/0Harmony.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<!-- bin/Debug/net10.0 is a complete mod folder, to pass to tools/test-instance.sh -->
	<ItemGroup>
		<None Include="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
